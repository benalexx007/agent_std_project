{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "domain": {
      "const": "research"
    },
    "study_type": {
      "type": "string",
      "enum": [
        "empirical",
        "reproduction",
        "theoretical",
        "survey"
      ]
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "include": {
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "reservation_tokens": {
          "type": "number",
          "minimum": 0
        },
        "reservation_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_total_tokens": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "max_attempts",
        "timeout_ms",
        "reservation_tokens",
        "reservation_cost_usd"
      ],
      "additionalProperties": false
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writes_workspace": {
      "type": "boolean"
    },
    "mock": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "boolean"
        },
        "missing_output": {
          "type": "boolean"
        },
        "malformed": {
          "type": "boolean"
        },
        "failed_check": {
          "type": "boolean"
        },
        "input_tokens": {
          "type": "number",
          "minimum": 0
        },
        "output_tokens": {
          "type": "number",
          "minimum": 0
        },
        "failure_code": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_after_ms": {
          "type": "integer",
          "minimum": 0
        },
        "progress_tokens": {
          "type": "number",
          "minimum": 0
        },
        "yield_after_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "work_units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "work_unit_id": {
            "type": "string",
            "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "estimate": {
            "type": "object",
            "properties": {
              "work_tokens": {
                "type": "number",
                "minimum": 0
              },
              "validation_tokens": {
                "type": "number",
                "minimum": 0
              },
              "checkpoint_tokens": {
                "type": "number",
                "minimum": 0
              },
              "margin_tokens": {
                "type": "number",
                "minimum": 0
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              },
              "context_growth_tokens": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "work_tokens",
              "validation_tokens",
              "checkpoint_tokens",
              "margin_tokens",
              "cost_usd",
              "context_growth_tokens"
            ],
            "additionalProperties": false
          },
          "mock": {
            "type": "object"
          },
          "estimate_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "work_unit_id",
          "objective",
          "dependencies",
          "expected_artifacts",
          "estimate"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "research_profile": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "enum": [
            "discovery",
            "extension",
            "reproduction",
            "synthesis"
          ]
        },
        "reasoning_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hypothesis",
              "mathematical",
              "experimental",
              "verification"
            ]
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "paper",
                "proof",
                "report",
                "artifact"
              ]
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "venue": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "format"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "goal",
        "reasoning_modes",
        "output"
      ],
      "additionalProperties": false
    },
    "research_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
      }
    },
    "purpose": {
      "type": "string",
      "enum": [
        "work",
        "benchmark"
      ]
    },
    "benchmark_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "task_class": {
      "type": "string",
      "enum": [
        "synthesis_planning",
        "analysis",
        "automation"
      ]
    },
    "model_tier": {
      "type": "string",
      "enum": [
        "highest",
        "medium",
        "low"
      ]
    },
    "reasoning_effort": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "model_selection": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "tier",
            "explicit",
            "backend_default",
            "unconfigured"
          ]
        },
        "model_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "model_family",
        "task_class",
        "model_tier",
        "model",
        "reasoning_effort"
      ],
      "additionalProperties": false
    },
    "analysis_input_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extension_profile": {
      "type": "string",
      "minLength": 1
    },
    "extension_scope": {
      "type": "object",
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "http_calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "max_records": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_papers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 104857600
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "max_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "task_id",
    "domain",
    "study_type",
    "task_revision",
    "role",
    "objective",
    "inputs",
    "dependencies",
    "acceptance",
    "expected_artifacts",
    "protocol_version",
    "capabilities",
    "budget",
    "stop_conditions",
    "required_actions",
    "writes_workspace"
  ],
  "additionalProperties": false
}
