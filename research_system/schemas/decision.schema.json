{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "impact"
        ],
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "affected_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "task_revisions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "grant_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes_decision_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "decision_id",
    "question",
    "reason",
    "options",
    "recommendation",
    "affected_tasks",
    "task_revisions",
    "grant_actions"
  ],
  "additionalProperties": false
}
