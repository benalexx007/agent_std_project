{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "control",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "status",
        "steer",
        "pause",
        "cancel",
        "resume"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "action",
    "target",
    "payload"
  ],
  "additionalProperties": false
}
