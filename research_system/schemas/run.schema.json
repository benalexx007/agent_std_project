{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "code_revision": {
      "type": "string",
      "minLength": 1
    },
    "patch_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object"
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": "object"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "attempt_id",
    "protocol_version",
    "code_revision",
    "patch_sha256",
    "data_version",
    "config",
    "model_version",
    "environment",
    "started_at",
    "ended_at",
    "status",
    "outputs"
  ],
  "additionalProperties": false
}
