{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "change_id": { "type": "string", "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$" },
    "reason": { "type": "string", "minLength": 1 },
    "feedback_refs": { "type": "array", "items": { "type": "object", "properties": {
      "record_id": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 },
      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }, "required": ["record_id", "revision", "sha256"], "additionalProperties": false } },
    "files": { "type": "array", "minItems": 1, "items": { "type": "object", "properties": {
      "target": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 },
      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }, "required": ["target", "path", "sha256"], "additionalProperties": false } },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "object", "properties": {
      "name": { "type": "string", "minLength": 1 }, "passed": { "type": "boolean" },
      "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "properties": {
        "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }, "required": ["path", "sha256"], "additionalProperties": false } }
    }, "required": ["name", "passed", "evidence"], "additionalProperties": false } }
  },
  "required": ["change_id", "reason", "feedback_refs", "files", "checks"],
  "additionalProperties": false
}
