{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "execution_manifest": { "type": "object", "properties": {
      "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }, "required": ["path", "sha256"], "additionalProperties": false },
    "request_id": { "type": "string", "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$" },
    "purpose": { "type": "string", "minLength": 1 },
    "protocol": { "type": "object", "properties": {
      "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }, "required": ["path", "sha256"], "additionalProperties": false },
    "task_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "limits": { "type": "object", "properties": {
      "max_attempts": { "type": "integer", "minimum": 1 }, "max_tokens": { "type": "number", "minimum": 0 },
      "max_cost_usd": { "type": "number", "minimum": 0 }
    }, "required": ["max_attempts", "max_tokens", "max_cost_usd"], "additionalProperties": false }
  },
  "required": ["request_id", "purpose", "protocol", "task_ids", "limits"], "additionalProperties": false
}
