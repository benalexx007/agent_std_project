{
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relation": {
      "type": "string",
      "enum": [
        "dependency",
        "subject"
      ]
    }
  },
  "required": [
    "record_id",
    "revision",
    "sha256"
  ],
  "additionalProperties": false
}
