{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "result",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "inconclusive"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "passed",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "cost_usd"
      ],
      "additionalProperties": false
    },
    "planning_review": {
      "type": "object",
      "properties": {
        "verified_for_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "needs_review"
          ]
        },
        "analysis_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "primary_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "enum": [
                  "primary_source_read",
                  "code_inspection",
                  "calculation",
                  "data_inspection"
                ]
              },
              "source": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "checked_at": {
                "type": "string",
                "minLength": 1
              },
              "finding": {
                "type": "string",
                "minLength": 1
              },
              "comparison_with_analysis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "claim",
              "method",
              "source",
              "checked_at",
              "finding",
              "comparison_with_analysis"
            ],
            "additionalProperties": false
          }
        },
        "research_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "query_or_inspection": {
                "type": "string",
                "minLength": 1
              },
              "checked_at": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "finding": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "question",
              "query_or_inspection",
              "checked_at",
              "sources",
              "finding"
            ],
            "additionalProperties": false
          }
        },
        "disagreements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocking_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "verified_for_attempt_id",
        "status",
        "analysis_refs",
        "primary_checks",
        "research_checks",
        "disagreements",
        "assumptions",
        "blocking_questions",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "task_id",
    "task_revision",
    "attempt_id",
    "protocol_version",
    "status",
    "summary",
    "artifacts",
    "evidence_refs",
    "checks",
    "limitations",
    "unresolved",
    "usage"
  ],
  "additionalProperties": false
}
