{
  "schema_version": 1,
  "bundle_root": "..",
  "project": {
    "id": "research-review",
    "domain": "research",
    "study_type": "reproduction",
    "objective": "Verify the research workflow implementation before live agent runs or evaluation experiments.",
    "workspace": "workspace"
  },
  "orchestrator": {
    "backend": "manual",
    "model": null
  },
  "roles": {
    "researcher": {
      "profile": "domains/research/roles/researcher.md",
      "skills": [
        "research-scope",
        "research-literature",
        "research-design",
        "research-evaluate",
        "research-write"
      ],
      "backend": "mock"
    },
    "implementer": {
      "profile": "domains/research/roles/implementer.md",
      "skills": [
        "research-experiment",
        "research-evaluate"
      ],
      "backend": "mock"
    },
    "evaluator": {
      "profile": "domains/research/roles/evaluator.md",
      "skills": [
        "research-evaluate",
        "research-design"
      ],
      "backend": "mock"
    }
  },
  "skills": {
    "research-scope": "skills/research-scope",
    "research-literature": "skills/research-literature",
    "research-design": "skills/research-design",
    "research-experiment": "skills/research-experiment",
    "research-evaluate": "skills/research-evaluate",
    "research-write": "skills/research-write"
  },
  "backends": {
    "mock": {
      "kind": "mock",
      "allow_execute": true
    },
    "manual": {
      "kind": "manual",
      "allow_execute": false,
      "model_family": "codex"
    },
    "codex": {
      "kind": "codex-cli",
      "command": "codex",
      "sandbox": "read-only",
      "model": null,
      "allow_execute": false
    },
    "claude": {
      "kind": "claude-cli",
      "command": "claude",
      "model": null,
      "allow_execute": false
    },
    "antigravity": {
      "kind": "agy-cli",
      "command": "agy",
      "model": null,
      "allow_execute": false
    }
  },
  "execution": {
    "mode": "adaptive",
    "allow_external": false,
    "max_concurrent": 2,
    "max_attempts": 20,
    "max_tokens": 100000,
    "max_cost_usd": null,
    "poll_ms": 50,
    "max_output_bytes": 1048576
  },
  "context": {
    "max_chars": 24000
  },
  "autonomy": {
    "grants": [
      {
        "id": "local-work",
        "actions": [
          "local_review"
        ],
        "task_ids": [
          "*"
        ]
      }
    ],
    "require_decision_for": [
      "change_main_question",
      "change_success_criteria",
      "increase_budget",
      "publish"
    ]
  },
  "control": {
    "cancel_grace_ms": 2000,
    "force_kill": false
  },
  "model_policy": {
    "default_task_class": "analysis",
    "orchestrator_task_class": "analysis",
    "task_class_backends": {
      "automation": "antigravity"
    },
    "task_class_tiers": {
      "synthesis_planning": "highest",
      "analysis": "medium",
      "automation": "low"
    },
    "backends": {
      "codex": {
        "highest": {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        },
        "medium": {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "high"
        },
        "low": {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "medium"
        }
      },
      "claude": null,
      "antigravity": {
        "low": {
          "model": "gemini-3.8-flash-high",
          "reasoning_effort": "high"
        }
      }
    },
    "planning_verification": {
      "independent_research": true,
      "primary_source_checks": true,
      "attempt_scoped_evidence": true
    }
  }
}
